{
  "name": "remotion-explainer",
  "version": "1.0.0",
  "description": "45-second explainer video about Remotion + AI",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render ExplainerVideo out/explainer.mp4",
    "build:gif": "remotion render ExplainerVideo out/explainer.gif --codec=gif",
    "build:openclaw": "remotion render OpenClawVideo out/openclaw.mp4",
    "build:comparison": "remotion render OpenClawComparison out/openclaw-comparison.mp4",
    "build:carousel": "remotion render SafeStepsCarousel out/safe-steps-carousel.mp4",
    "build:agency-process": "remotion render AgencyProcess out/agency-process.mp4",
    "build:offer-time": "remotion render OfferTime out/offer-time.mp4",
    "build:ai-transform": "remotion render AITransform out/ai-transform.mp4",
    "build:automation-evolution": "remotion render AutomationEvolutionVideo out/automation-evolution.mp4",
    "build:four-way-decision": "remotion render FourWayDecisionVideo out/four-way-decision.mp4",
    "build:micro-tool": "remotion render MicroToolVideo out/micro-tool.mp4",
    "build:zapier-series": "npm run build:automation-evolution && npm run build:four-way-decision && npm run build:micro-tool"
  },
  "keywords": [
    "remotion",
    "video",
    "explainer"
  ],
  "author": "Paweł Lipowczan",
  "license": "MIT",
  "dependencies": {
    "@remotion/cli": "^4.0.414",
    "@remotion/google-fonts": "^4.0.414",
    "@remotion/transitions": "^4.0.414",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "^4.0.414"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
