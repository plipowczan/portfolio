# Google Gemini API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default model for image generation
# Options: gemini-3-pro-image-preview, gemini-2.5-flash-image
GEMINI_MODEL=gemini-3-pro-image-preview

# Optional: Default image size
# Options: 1K, 2K, 4K, or custom dimensions like 1200x630
IMAGE_SIZE=1200x630

# Optional: Vercel/deployment environment variables
# VITE_API_URL=https://api.example.com
# VITE_FORM_ENDPOINT=https://formspree.io/f/your-form-id

# Resend — /llm-wiki waitlist capture (used by api/subscribe.js)
# SERVER-SIDE ONLY: set these in the Vercel project env (Production + Preview).
# Never prefix with VITE_ and never expose to the client.
# API key (contacts + sending scope): https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
# ID of the "LLM Wiki" Audience: https://resend.com/audiences
RESEND_AUDIENCE_ID=your_resend_audience_id_here
